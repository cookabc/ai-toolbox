<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The interface is written in Simplified Chinese only. Declaring it as the
       development region and sole localization makes the system pieces inside the
       panel (text-field menus, Foundation's error messages) use the same language,
       instead of following an English-first system language list. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>zh-Hans</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>zh-Hans</string>
  </array>
  <key>CFBundleDisplayName</key>
  <string>AI Toolbox</string>
  <key>CFBundleExecutable</key>
  <string>AIToolbox</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.cookabc.ai-toolbox</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>AIToolbox</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <key>LSUIElement</key>
  <true/>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- Saved providers are often plain-HTTP relays on a LAN or an internal
       hostname. App Transport Security would refuse those before the request
       left the machine, and the probe would report an ATS error instead of the
       gateway's real status. NSAllowsLocalNetworking is not enough here: it
       covers .local names and link-local addresses, not 192.168/10.x hosts. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
  </dict>
</dict>
</plist>
